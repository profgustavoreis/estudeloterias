# Servidor
PORT=5000
NODE_ENV=development
BASE_PATH=/

# Banco de Dados
DATABASE_URL=

# Anúncios (opcional — vazio = sem anúncios)
# VITE_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxx

# Anúncios (opcional — desliga todos os widgets quando false)
# VITE_ADSENSE_ENABLED=false

# IA — Geração de Artigos (OpenAI-compatível; padrão: OpenCode Zen/Go)
# Base URL do provedor OpenAI-compatível (/chat/completions será anexado).
LLM_BASE_URL=https://opencode.ai/zen/v1
# Chave da API. Deixe vazio para usar os modelos gratuitos do OpenCode Zen
# (o gateway aceita "Bearer public"; ~200 req/dia por IP, sem garantias).
LLM_API_KEY=
# Modelo usado na geração. Gratuitos atuais: deepseek-v4-flash-free,
# big-pickle, mimo-v2.5-free (catálogo rotaciona — consulte GET /v1/models).
LLM_MODEL=deepseek-v4-flash-free
# Modo thinking do modelo: disabled | low | medium | high.
# disabled (recomendado para artigos): 0 tokens de raciocínio, deterministico,
# e temperature/tom passam a ter efeito. low/medium/high enviam reasoning_effort
# (soft no gateway, estocástico — pode esvaziar o max_tokens em artigos longos).
LLM_THINKING=disabled
# Timeout de cada chamada em ms.
LLM_TIMEOUT_MS=180000