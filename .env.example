# Servidor
PORT=5000
NODE_ENV=development
BASE_PATH=/

# Banco de Dados
DATABASE_URL=

# Servir o build de produção do SPA a partir do api-server (injeção SEO server-side)
# Caminho absoluto para o diretório `dist/public` do frontend. Sem esta env o
# api-server continua sendo somente API/sitemap (frontend servido separadamente).
# FRONTEND_DIST=/caminho/para/o/repo/artifacts/estude-loterias/dist/public

# Anúncios (opcional — vazio = sem anúncios)
# VITE_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxx

# Anúncios (opcional — desliga todos os widgets quando false)
# VITE_ADSENSE_ENABLED=false

# IA — Geração de Artigos (OpenAI-compatível; padrão: OpenCode Zen/Go)
# Base URL do provedor OpenAI-compatível (/chat/completions será anexado).
LLM_BASE_URL=https://opencode.ai/zen/v1
# Chave da API. Deixe vazio para usar os modelos gratuitos do OpenCode Zen
# (o gateway aceita "Bearer public"; ~200 req/dia por IP, sem garantias).
LLM_API_KEY=
# Modelo usado na geração. Gratuitos atuais: deepseek-v4-flash-free,
# big-pickle, mimo-v2.5-free (catálogo rotaciona — consulte GET /v1/models).
# Usado somente quando LLM_MODELS (abaixo) está vazio.
LLM_MODEL=deepseek-v4-flash-free
# Cadeia de fallback em ordem de tentativa. Tem precedência sobre LLM_MODEL.
# Regra do sufixo: modelos terminados em `-free` usam LLM_BASE_URL (grátis);
# os demais usam LLM_GO_BASE_URL (pago — o chain só toca o pago DEPOIS que o
# grátis falha, p.ex. 429 FreeUsageLimitError). A MESMA chave vale para ambos.
LLM_GO_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODELS=deepseek-v4-flash-free,deepseek-v4-flash
# Override de endpoint por modelo (formato model:free|go). Ex.:
# LLM_MODEL_ENDPOINTS=deepseek-v4-flash-free:free,deepseek-v4-flash:go
# Retries/backoff por candidato (aplicado só a server/timeout/network).
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_MS=1000
# Modo thinking do modelo: disabled | low | medium | high.
# disabled (recomendado para artigos): 0 tokens de raciocínio, deterministico,
# e temperature/tom passam a ter efeito. low/medium/high enviam reasoning_effort
# (soft no gateway, estocástico — pode esvaziar o max_tokens em artigos longos).
LLM_THINKING=disabled
# Timeout de cada chamada (por tentativa) em ms.
LLM_TIMEOUT_MS=60000